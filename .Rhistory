library(tidyverse)
library(ggplot2)
library(foreign)
library(scales)
library(readxl)
library(stringr)
pobreza <- read.csv(params$datafile2)
pib <- read_xlsx(params$datafile3)
ipc <- read_xlsx(params$datafile4)
#Gráfico de línea
pobreza %>%
rename(Periodo = Año,
T_pobreza = Tasa_de_pobreza_.) %>%
ggplot(aes(x=Periodo, y = T_pobreza)) +
geom_line(colour = "#006AA7", lwd = 1, linetype = 1)+
geom_point()+
geom_text(aes(label = T_pobreza), vjust = -0.5, size = 3.5) +
labs(
title = "Tasa de pobreza nacional (% de la población)",
subtitle = "Periodo: 2002-2022",
x= "Año ",
y = "Tasa de pobreza (%)",
caption = "Elaboración propia con datos de WDI/UNdata y Banco Mundial"
)+
theme_bw()
# Tasa de Crecimiento del PIB de Bolivia a precios constantes
pib %>%
mutate(`Var. PIB (%)` = str_remove_all(`Var. PIB (%)`, "%"),   # Quitar el %
`Var. PIB (%)` = str_replace_all(`Var. PIB (%)`, ",", "."), # Reemplazar la coma decimal por punto
`Var. PIB (%)` = as.numeric(`Var. PIB (%)`)
) %>%
rename(Periodo = Fecha,
var_pib = `Var. PIB (%)`) %>%
ggplot(aes(x=Periodo, y = var_pib)) +
geom_rect(aes(xmin=2005, xmax=2024, ymin = -Inf,ymax= Inf ),
fill = "#006AA7", aplha = 0.8, inherit.aes = FALSE) +
geom_line(colour = "#FECC02", lwd = 1, linetype = 1)+
geom_point()+
geom_text(aes(x=2015.05, y=max(var_pib, na.rm = TRUE)+ 1),
label = "Gobiernos del MAS", color = "#FECC02", size = 5, fontface = "bold")+
scale_x_continuous(breaks = 1961:2024, labels = as.character(1961:2024)) +
labs(
title = "Tasa de crecimiento del PIB a precios constantes",
subtitle = "Periodo: 1961-2024",
x= "Periodo",
y = "Variación del PIB (%)",
caption = "Elaboración propia con datos de datosmacro.com"
)+
theme_bw()+
theme(panel.background = element_rect(fill = "#FAF6F5", color = NA),
axis.text.x = element_text(angle = 90, hjust = 1))
## IPC
# Convertir a formato largo
ipc_long <- ipc %>%
pivot_longer(
cols = -MES,   # todas las columnas excepto MES
names_to = "Año",
values_to = "Valor"
) %>%
mutate(
# Crear un factor para ordenar los meses si se quiere
MES = factor(MES, levels = c("Enero", "Febrero", "Marzo", "Abril", "Mayo",
"Junio", "Julio", "Agosto", "Septiembre",
"Octubre", "Noviembre", "Diciembre")),
Año = as.integer(Año)
)
# Graficar línea
ggplot(ipc_long, aes(x = MES, y = Valor, group = Año, color = factor(Año))) +
geom_line() +
geom_point() +
labs(
title = "Variación mensual del IPC por año",
x = "Mes",
y = "Valor",
color = "Año",
caption = "Elaboración propia con datos del\n Instituto Nacional de Estadísticas de Bolivia, 2025"
) +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
