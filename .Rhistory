#librerías
library(foreign)
library(tidyverse)
library(dplyr)
library(scales)
library(kableExtra)
library(readr)
library(readxl)
library(ggplot2)
library(forcats)
kb_a <- read.csv(params$datafile1, fileEncoding = "Latin1", stringsAsFactors = FALSE)
tb_aspirantes_kb <-kb_a %>%
dplyr::select(Nombre, Edad_contienda,Genero,Departamento,Coalición,Partido,Bloque, Activo, kb, Votos) %>%
rename(Candidato = Nombre,
Edad = Edad_contienda,
Género = Genero,
"Departamento de nacimiento" = Departamento,
"Candidatura activa\npara Segunda Vuelta" = Activo,
"Capital burocrático" = kb,
"% de Votos\n1°vuelta" = Votos
) %>%
mutate(Género = case_when(Género == "H"~"Hombre",
Género == "M"~"Mujer")) %>%
arrange(desc(`Capital burocrático`))
# Luego aplicas kable y kableExtra sobre ese data frame
tb_aspirantes_kb %>%
kable(caption = "Elaborado por: n0dn | The linked data", booktabs = TRUE, linesep = "") %>%
kable_styling(
bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = FALSE,
position = "center",
font_size = 14
) %>%
row_spec(0, bold = TRUE, background = "#006AA7", color = "#FECC02") %>%  # encabezado azul y blanco
row_spec(which(tb_aspirantes_kb$`Candidatura activa\npara Segunda Vuelta` == "Sí"), background = "#D9EAD3") %>%  # filas activas en verde suave
column_spec(1, bold = TRUE, color = "#0B3B0B") %>%   # Columna candidato en negrita y color
add_header_above(c(" " = 1, "Información básica" = 3, "Afiliación política" = 3, "Actividad electoral" = 3))
