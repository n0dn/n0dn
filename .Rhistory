library(tidyverse)
library(ggplot2)
library(foreign)
periodo <- c(2002,2005,2009,2014,2019,2020,2025)
candidato <- c("Evo Morales","Evo Morales","Evo Morales","Evo Morales","Evo Morales","Luis Arce", "Carlos Del Castillo")
votos <- c(20.94,53.74,64.22,61.36,47.08,55.11,3.17)
exito <- c("Perdedor","Ganador","Ganador","Ganador","Ganador","Ganador","Perdedor")
mas <- data.frame(periodo,candidato,votos,exito)
mas %>%
ggplot(aes(x=periodo,y=votos)) +
geom_line(colour = "#006AA7", lwd = 1, linetype = 1)+
geom_point()+
geom_text(aes(label = paste(candidato, "\n", votos, "\n", exito)), vjust = 0.8, size = 3) +
labs(title = "Evolución del voto por el partido Movimiento al Socialismo (MAS)",
subtitle = "Periodo: 2002-2025",
x= "Años de contienda electoral",
y = "% de votos",
caption = "Elaboracion propia con datos del Órgano Electoral Plurinacional de Bolivia")+
theme_bw()
